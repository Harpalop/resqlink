# Public URL the app is served from — used to generate the Medical ID QR link.
# Leave unset for local development (the app uses the current browser origin,
# so opening via your PC's LAN IP makes the QR scannable on the same WiFi).
# Set this to your deployed domain in production so scanned QR codes resolve
# from any phone, anywhere.
VITE_PUBLIC_APP_URL=https://your-app.vercel.app
